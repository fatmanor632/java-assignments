public class ReversedStepsDemo {

    static void print(String label, Node<String> head) {

        System.out.print(label);

        Node<String> cur = head;

        for (int i = 0; i < 5 && cur != null; i++) {

            System.out.print(cur.getElement() + " -> ");

            cur = cur.getNext();
        }

        System.out.println(cur == null ? "null" : "...");
    }

    public static void main(String[] args) {

        // Correct order

        Node<String> head = new Node<>("B");

        Node<String> newNode = new Node<>("A");

        newNode.setNext(head);

        head = newNode;

        print("Correct: ", head);


        // Swapped order

        head = new Node<>("B");

        newNode = new Node<>("A");

        head = newNode;

        newNode.setNext(head);

        print("Swapped: ", head);
    }
}

public class Node<T> {

    private T element;
    private Node<T> next;

    public Node() {
        element = null;
        next = null;
    }

    public Node(T element) {
        this.element = element;
        next = null;
    }

    public Node<T> getNext() {
        return next;
    }

    public void setNext(Node<T> next) {
        this.next = next;
    }

    public T getElement() {
        return element;
    }

    public void setElement(T element) {
        this.element = element;
    }
}

public class LinkedStack<T> {

    private int count;
    private Node<T> top;

    public LinkedStack() {
        count = 0;
        top = null;
    }

    public void push(T element) {

        Node<T> temp = new Node<>(element);

        temp.setNext(top);

        top = temp;

        count++;
    }

    public T pop() throws EmptyStackException {

        if (isEmpty()) {
            throw new EmptyStackException();
        }

        T result = top.getElement();

        top = top.getNext();

        count--;

        return result;
    }

    public T peek() throws EmptyStackException {

        if (isEmpty()) {
            throw new EmptyStackException();
        }

        return top.getElement();
    }

    public boolean isEmpty() {
        return count == 0;
    }

    public int size() {
        return count;
    }
}
