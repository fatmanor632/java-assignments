//Book classes
class Book {
    String title;
    String author;
    int pages;

    Book(String bTitle, String bAuthor, int bPages) {
        title = bTitle;
        author = bAuthor;
        pages = bPages;
    }

    void describe() {
        System.out.println("\"" + title + "\" by " + author
                + " - " + pages + " pages");
    }
}

public class Main {
    public static void main(String[] args) {

        Book b1 = new Book("Clean Code", "Robert Martin", 464);

        Book b2 = new Book("Java Software Structures", "Lewis & Chase", 592);

        b1.describe();
        b2.describe();
    }
}
//courses class
class Course {
